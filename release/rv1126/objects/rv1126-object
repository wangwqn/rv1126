#!/bin/sh
set -eu

APP_DIR=${RV1126_APP_DIR:-/root/rv1126_objects}
APP="$APP_DIR/rkmedia_object_detection_rtsp"
PID_FILE=${RV1126_PID_FILE:-/var/run/rv1126-object.pid}
LOG_FILE=${RV1126_LOG_FILE:-/tmp/rv1126-object.log}

running_pid() {
    [ -s "$PID_FILE" ] || return 1
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    [ -d "/proc/$pid" ] || return 1
    command_line=$(tr '\000' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    case "$command_line" in *"$APP"*) printf '%s\n' "$pid" ;; *) return 1 ;; esac
}

start_service() {
    if pid=$(running_pid); then
        echo "Already running: pid=$pid"
        return 0
    fi
    rm -f "$PID_FILE"
    [ -x "$APP" ] || { echo "Missing executable: $APP" >&2; return 1; }
    [ -s "$APP_DIR/objects.rknn" ] || { echo "Missing model: $APP_DIR/objects.rknn" >&2; return 1; }
    if [ "$#" -eq 0 ]; then
        set -- --sensor-mode 1080p --rotation 270 --threshold 0.35
    fi
    cd "$APP_DIR"
    : >"$LOG_FILE"
    nohup start-stop-daemon -S -m -p "$PID_FILE" -x "$APP" -- "$@" \
        >"$LOG_FILE" 2>&1 </dev/null &
    sleep 2
    if pid=$(running_pid); then
        echo "Started: pid=$pid log=$LOG_FILE"
        return 0
    fi
    echo "Start failed; log follows:" >&2
    tail -80 "$LOG_FILE" >&2 || true
    return 1
}

stop_service() {
    if ! pid=$(running_pid); then
        rm -f "$PID_FILE"
        echo "Not running"
        return 0
    fi
    kill -TERM "$pid"
    count=0
    while [ -d "/proc/$pid" ] && [ "$count" -lt 20 ]; do
        sleep 1
        count=$((count + 1))
    done
    if [ -d "/proc/$pid" ]; then
        echo "Graceful stop timed out; sending KILL" >&2
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
    echo "Stopped"
}

status_service() {
    version=unknown
    [ ! -s "$APP_DIR/VERSION" ] || version=$(tr -d '[:space:]' <"$APP_DIR/VERSION")
    if pid=$(running_pid); then
        echo "Running: version=$version pid=$pid app=$APP log=$LOG_FILE"
        return 0
    fi
    echo "Stopped: version=$version"
    return 3
}

pipeline_frame() {
    channel=$1
    sed -n "/^Output .*${channel}/s/.*(frame:\([0-9][0-9]*\).*/\1/p" /proc/rkispp0 2>/dev/null | head -1
}

health_service() {
    interval=${RV1126_HEALTH_INTERVAL:-3}
    case "$interval" in *[!0-9]*|'') echo "Invalid health interval: $interval" >&2; return 2 ;; esac
    [ "$interval" -ge 1 ] && [ "$interval" -le 30 ] || {
        echo "Health interval must be between 1 and 30 seconds" >&2
        return 2
    }
    pid=$(running_pid) || { echo "Unhealthy: service is not running" >&2; return 1; }
    netstat -lnt 2>/dev/null | grep -q ':8554[[:space:]]' || {
        echo "Unhealthy: RTSP TCP port 8554 is not listening" >&2
        return 1
    }
    main_before=$(pipeline_frame rkispp_scale0)
    sub_before=$(pipeline_frame rkispp_scale1)
    [ -n "$main_before" ] && [ -n "$sub_before" ] || {
        echo "Unhealthy: cannot read ISPP output counters" >&2
        return 1
    }
    sleep "$interval"
    running_pid >/dev/null || { echo "Unhealthy: service exited during sampling" >&2; return 1; }
    main_after=$(pipeline_frame rkispp_scale0)
    sub_after=$(pipeline_frame rkispp_scale1)
    [ -n "$main_after" ] && [ -n "$sub_after" ] || {
        echo "Unhealthy: ISPP counters disappeared" >&2
        return 1
    }
    [ "$main_after" -gt "$main_before" ] && [ "$sub_after" -gt "$sub_before" ] || {
        echo "Unhealthy: video counters did not advance" >&2
        return 1
    }
    errors=$(sed -n 's/^Interrupt .*ErrCnt:\([0-9][0-9]*\).*/\1/p' /proc/rkispp0 | head -1)
    [ "${errors:-1}" -eq 0 ] || { echo "Unhealthy: ISPP ErrCnt=$errors" >&2; return 1; }
    tnr=$(grep '^TNR ' /proc/rkispp0 2>/dev/null | head -1)
    echo "$tnr" | grep -q 'TNR[[:space:]]*ON' || {
        echo "Unhealthy: TNR is not ON" >&2
        return 1
    }
    audio_fd=0
    for fd in /proc/"$pid"/fd/*; do
        case "$(readlink "$fd" 2>/dev/null || true)" in
            /dev/snd/pcm*C*c) audio_fd=1; break ;;
        esac
    done
    [ "$audio_fd" -eq 1 ] || {
        echo "Unhealthy: ALSA capture device is not open" >&2
        return 1
    }
    audio_line=$(grep ' audio(captured=' "$LOG_FILE" 2>/dev/null | tail -1)
    audio_captured=$(echo "$audio_line" | sed -n 's/.*audio(captured=\([0-9][0-9]*\).*/\1/p')
    [ -n "$audio_captured" ] && [ "$audio_captured" -gt 0 ] || {
        echo "Unhealthy: audio capture has not produced packets" >&2
        return 1
    }
    version=unknown
    [ ! -s "$APP_DIR/VERSION" ] || version=$(tr -d '[:space:]' <"$APP_DIR/VERSION")
    echo "Healthy: version=$version pid=$pid interval=${interval}s main_delta=$((main_after-main_before)) sub_delta=$((sub_after-sub_before)) audio_packets=$audio_captured ErrCnt=$errors TNR=ON RTSP=8554"
}

command=${1:-}
[ "$#" -eq 0 ] || shift
case "$command" in
    start) start_service "$@" ;;
    stop) stop_service ;;
    restart) stop_service; start_service "$@" ;;
    status) status_service ;;
    health) health_service ;;
    foreground)
        cd "$APP_DIR"
        if [ "$#" -eq 0 ]; then
            set -- --sensor-mode 1080p --rotation 270 --threshold 0.35
        fi
        exec "$APP" "$@"
        ;;
    install-autostart)
        script=$(readlink -f "$0")
        ln -sfn "$script" /etc/init.d/S99rv1126-object
        echo "Installed boot service: /etc/init.d/S99rv1126-object"
        ;;
    remove-autostart)
        if [ -L /etc/init.d/S99rv1126-object ]; then
            rm /etc/init.d/S99rv1126-object
        fi
        echo "Removed boot service"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|health|foreground|install-autostart|remove-autostart} [program options...]" >&2
        exit 2
        ;;
esac
