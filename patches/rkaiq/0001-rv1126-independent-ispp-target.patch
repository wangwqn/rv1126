@@ -26,6 +26,40 @@
 #include <sys/mman.h>
 #include <fcntl.h>

+extern "C" int rk_aiq_ispp_target_override_version()
+{
+    return 1;
+}
+
+static int get_ispp_target_override()
+{
+    const char* value = getenv("RKAIQ_ISPP_TARGET");
+    if (!value || !*value)
+        return -1;
+    char* end = NULL;
+    const long index = strtol(value, &end, 10);
+    if (!end || *end || index < 0 || index >= MAX_CAM_NUM)
+        return -1;
+    return static_cast<int>(index);
+}
+
+static bool get_ispp_input_size_override(uint32_t& width, uint32_t& height)
+{
+    const char* value = getenv("RKAIQ_ISPP_INPUT_SIZE");
+    if (!value || !*value)
+        return false;
+    unsigned parsed_width = 0;
+    unsigned parsed_height = 0;
+    char trailing = '\0';
+    if (sscanf(value, "%ux%u%c", &parsed_width, &parsed_height, &trailing) != 2 ||
+            parsed_width < 32 || parsed_height < 32 ||
+            parsed_width > 8192 || parsed_height > 8192)
+        return false;
+    width = parsed_width;
+    height = parsed_height;
+    return true;
+}
